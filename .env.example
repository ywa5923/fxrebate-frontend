# Local Next.js development. Copy this file to .env.local and replace placeholders.

# MapTiler public browser key; configure restrictions in the MapTiler dashboard.
NEXT_PUBLIC_MAPTILER_API_KEY=your_maptiler_public_key

# Generate unique random values for local use. Never reuse production secrets here.
JWT_SECRET=replace-with-a-long-random-local-secret
REVALIDATE_SECRET=replace-with-a-long-random-local-secret

# Legacy/optional backend URL. Current frontend API code reads NEXT_PUBLIC_API_URL.
LARAVEL_API_URL=http://localhost:8080

# Optional browser logging endpoint and key.
# NEXT_PUBLIC_LOG_API_URL=https://your-api.example.test/api/logs
# NEXT_PUBLIC_LOG_API_KEY=replace-with-a-dummy-local-log-key
NEXT_PUBLIC_LOG_LEVEL=debug

# Local admin identity used by the app, if needed.
SUPER_ADMIN_EMAIL=admin@example.test
SUPER_ADMIN_NAME=Local Admin

# Used by Hero assets and API requests during local development.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# R2 credentials are server-only. Replace every value with your own local/test values.
CLOUDFLARE_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=your-r2-bucket-name
CLOUDFLARE_R2_PUBLIC_URL=https://your-public-r2-url.example.test

# Next.js sets NODE_ENV automatically; this is shown for reference only.
NODE_ENV=development
